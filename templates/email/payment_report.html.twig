{% extends 'email.html.twig' %}

{% block title %}Отчет об оплаченных курсах{% endblock %}

{% block body %}
<h3>Отчет об оплаченных курсах за период {{ startDate|date('d.m.Y') }} - {{ endDate|date('d.m.Y') }}</h3>

{% if courseStats is empty %}
    <p>За указанный период оплат не зарегистрировано.</p>
{% else %}
    <table style="width: 100%; border-collapse: collapse; margin: 20px 0; font-family: arial; font-size: 14px;">
        <thead>
            <tr style="background-color: #f8f9fa;">
                <th style="border: 1px solid #dee2e6; padding: 12px; text-align: left;">Название курса</th>
                <th style="border: 1px solid #dee2e6; padding: 12px; text-align: left;">Тип курса</th>
                <th style="border: 1px solid #dee2e6; padding: 12px; text-align: center;">Число аренд/покупок</th>
                <th style="border: 1px solid #dee2e6; padding: 12px; text-align: right;">Общая сумма</th>
            </tr>
        </thead>
        <tbody>
            {% for courseCode, stats in courseStats %}
                <tr>
                    <td style="border: 1px solid #dee2e6; padding: 12px;">{{ stats.title }}</td>
                    <td style="border: 1px solid #dee2e6; padding: 12px;">{{ stats.type|title }}</td>
                    <td style="border: 1px solid #dee2e6; padding: 12px; text-align: center;">
                        {% if stats.rent_count > 0 and stats.buy_count > 0 %}
                            {{ stats.rent_count }} аренд / {{ stats.buy_count }} покупок
                        {% elseif stats.rent_count > 0 %}
                            {{ stats.rent_count }}
                        {% elseif stats.buy_count > 0 %}
                            {{ stats.buy_count }}
                        {% else %}
                            0
                        {% endif %}
                    </td>
                    <td style="border: 1px solid #dee2e6; padding: 12px; text-align: right;">{{ stats.total_amount|number_format(2, '.', '') }} руб.</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr style="background-color: #f8f9fa; font-weight: bold;">
                <td colspan="3" style="border: 1px solid #dee2e6; padding: 12px; text-align: right;">Итого:</td>
                <td style="border: 1px solid #dee2e6; padding: 12px; text-align: right;">{{ totalAmount|number_format(2, '.', '') }} руб.</td>
            </tr>
        </tfoot>
    </table>
{% endif %}

<p style="margin-top: 30px; font-size: 12px; color: #6c757d;">
    Отчет сгенерирован автоматически {{ "now"|date('d.m.Y H:i') }}
</p>
{% endblock %} 